### Git refuses a second checkout of the same branch
$ git worktree add ../campus-helpdesk-wt/dup feature/mcp-server
Preparing worktree (checking out 'feature/mcp-server')
fatal: 'feature/mcp-server' is already checked out at '/Users/anuragkharke/Desktop/campus-helpdesk-wt/mcp-server'

[exit code of the refused add: 128]

### Shared object database: every worktree reports the same common dir
. -> git-dir=.git common-dir=.git
../campus-helpdesk-wt/skill-tests -> git-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git/worktrees/skill-tests common-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git
../campus-helpdesk-wt/mcp-server -> git-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git/worktrees/mcp-server common-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git
../campus-helpdesk-wt/hook-path -> git-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git/worktrees/hook-path common-dir=/Users/anuragkharke/Desktop/campus-helpdesk/.git

